# Foto's en filmpjes: een bezoeker die terugkomt hoeft ze niet opnieuw te laden.
# De tijden zijn kort gehouden omdat dezelfde bestandsnaam soms een nieuw filmpje krijgt.
/img/*
  Cache-Control: public, max-age=604800
/film/*
  Cache-Control: public, max-age=86400
# Lettertypen veranderen nooit onder dezelfde naam (bij een nieuwe versie komt er een nieuwe naam).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
